# Entra sign-in. Pull the real values from SSM:
#   aws ssm get-parameters-by-path --path /amplify/shared/<app-id> \
#     --recursive --with-decryption
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL=http://localhost:3000

# Where /api/transactions proxies to. Either the local payment-portal dev
# server, or a deployed environment's API Gateway stage.
PAYMENT_PORTAL_API_URL=http://localhost:8080

# The BFF signs upstream requests with SigV4, so the signer needs credentials
# even locally. The local dev server never verifies the signature, so these
# placeholders are enough. Delete them to sign with your own `aws sso login`
# credentials when pointing PAYMENT_PORTAL_API_URL at a deployed environment.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=us-east-1
