{
  "name": "ustc-payment-portal-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.20.0 <25.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:ci": "biome lint --reporter=github .",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config e2e/playwright.config.ts --project=anonymous",
    "test:e2e:auth": "playwright test --config e2e/playwright.config.ts --project=authenticated",
    "test:a11y": "playwright test --config e2e/playwright.config.ts --project=accessibility-anonymous --project=accessibility-authenticated",
    "test:e2e:login": "playwright test --config e2e/playwright.config.ts --project=setup --headed"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/credential-providers": "^3.1139.0",
    "@base-ui/react": "^1.8.0",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-auth": "^4.24.15",
    "nuqs": "^2.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "4.13.0",
    "jsdom": "^30.1.0",
    "shadcn": "^4.15.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
